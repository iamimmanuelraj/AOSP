{
  "name": "aosp-site",
  "private": true,
  "type": "module",
  "description": "Static site for github.com/iamimmanuelraj/AOSP: renders the Markdown in DEVICES/ into pages, plus the OTA update API and the web installer",
  "scripts": {
    "build": "node build.mjs",
    "serve": "node build.mjs && npx --yes http-server ../_site -p 8080 -c-1"
  },
  "dependencies": {
    "@lineageos-infra/android-fastboot": "1.1.6",
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-credential-web": "2.1.0",
    "@yume-chan/adb-daemon-webusb": "2.3.2",
    "esbuild": "0.28.2",
    "hash-wasm": "4.13.0",
    "js-yaml": "4.3.2",
    "marked": "15.0.12"
  },
  "devDependencies": {
    "usb": "3.2.1"
  }
}
