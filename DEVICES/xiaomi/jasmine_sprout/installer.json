 "sources": {
  "release": {
   "title": "LineageOS release files",
   "help": "Download boot.img, vbmeta.img, super_system.img, super_vendor.img and SHA256SUMS from the release page, then select them all here. Every file is checked against SHA256SUMS before anything is flashed."
  },
  "stock": {
   "title": "Stock firmware V11.0.28.0.QDIMIXM (Android 10)",
   "help": "Download jasmine_global_images_V11.0.28.0.QDIMIXM_10.0 (fastboot ROM .tgz) from Xiaomi, extract it (7-Zip on Windows, tar on Linux/macOS) and select its images folder. Only this exact version is accepted: older firmware can trigger anti-rollback and brick the phone."
  }
 },
 "flows": {
  "unlock": {
   "title": "Unlock the bootloader",
   "summary": "From stock: allow flashing. Erases everything on the phone.",
   "before": [
    "Back up everything: unlocking erases the phone.",
    "In Android: Settings > About phone > tap Build number 7 times, then Settings > System > Developer options > turn on OEM unlocking.",
    "Turn the phone off, then hold Volume Down + Power until FASTBOOT appears, and connect it to this computer."
   ],
   "files": [],
   "steps": [
    {
     "do": "check",
     "var": "product",
     "in": [
      "jasmine"
     ],
     "fail": "This is not a Mi A2."
    },
    {
     "do": "check",
     "var": "unlocked",
     "in": [
      "no"
     ],
     "skipRestIfNot": true,
     "note": "Already unlocked: nothing to do."
    },
    {
     "do": "command",
     "cmd": "flashing unlock",
     "phone": "On the phone: press Volume Up to select UNLOCK, then Power to confirm. The phone erases itself."
    },
    {
     "do": "reconnect",
     "text": "If the phone left fastboot, hold Volume Down + Power until FASTBOOT appears again, then press Reconnect."
    },
    {
     "do": "command",
     "cmd": "flashing unlock_critical",
     "phone": "On the phone: confirm once more with the volume keys and Power.",
     "optional": true
    },
    {
     "do": "reconnect",
     "text": "Back in FASTBOOT? Press Reconnect."
    },
    {
     "do": "check",
     "var": "unlocked",
     "in": [
      "yes"
     ],
     "fail": "Still locked. Boot Android, make sure OEM unlocking is on, and try again."
    },
    {
     "do": "done",
     "text": "Unlocked. You can install LineageOS now."
    }
   ],
   "enabled": false,
   "disabledText": "Being tested on a real Mi A2. This flow opens once it has passed end to end; until then use the command-line steps on the release page."
  },
  "install": {
   "title": "Install LineageOS",
   "summary": "Flash a LineageOS release from the bootloader. Needs an unlocked bootloader.",
   "before": [
    "Unlock the bootloader first (the Unlock tab).",
    "Charge the phone to at least 50 %.",
    "Boot to FASTBOOT (Volume Down + Power) and connect it."
   ],
   "options": {
    "wipe": {
     "label": "Clean install: erase all data",
     "default": true,
     "help": "Needed for a first install or when the release page says clean flash. Turn off only to update a build signed with the same keys."
    },
    "firmware": {
     "label": "Also flash the stock V11.0.28 firmware to both slots",
     "default": false,
     "help": "Recommended once per phone, so both slots have the same firmware. Needs the stock firmware folder and a critical unlock."
    }
   },
   "files": [
    "boot",
    "vbmeta",
    "super_system",
    "super_vendor",
    "sums"
   ],
   "steps": [
    {
     "do": "check",
     "var": "product",
     "in": [
      "jasmine"
     ],
     "fail": "This is not a Mi A2."
    },
    {
     "do": "check",
     "var": "unlocked",
     "in": [
      "yes"
     ],
     "fail": "The bootloader is locked. Use the Unlock tab first."
    },
    {
     "do": "slot",
     "as": "T",
     "from": "current"
    },
    {
     "do": "flash",
     "part": "bluetooth",
     "slot": "both",
     "file": "stock:bluetooth.img",
     "if": "firmware"
    },
    {
     "do": "flash",
     "part": "devcfg",
     "slot": "both",
     "file": "stock:devcfg.img",
     "if": "firmware"
    },
    {
     "do": "flash",
     "part": "dsp",
     "slot": "both",
     "file": "stock:dsp.img",
     "if": "firmware"
    },
    {
     "do": "flash",
     "part": "modem",
     "slot": "both",
     "file": "stock:modem.img",
     "if": "firmware"
    },
    {
     "do": "flash",
     "part": "xbl",
     "slot": "both",
     "file": "stock:xbl.img",
     "if": "firmware"
    },
    {
     "do": "flash",
     "part": "pmic",
     "slot": "both",
     "file": "stock:pmic.img",
     "if": "firmware"
    },
    {
     "do": "flash",
     "part": "rpm",
     "slot": "both",
     "file": "stock:rpm.img",
     "if": "firmware"
    },
    {
     "do": "flash",
     "part": "tz",
     "slot": "both",
     "file": "stock:tz.img",
     "if": "firmware"
    },
    {
     "do": "flash",
     "part": "hyp",
     "slot": "both",
     "file": "stock:hyp.img",
     "if": "firmware"
    },
    {
     "do": "flash",
     "part": "keymaster",
     "slot": "both",
     "file": "stock:keymaster.img",
     "if": "firmware"
    },
    {
     "do": "flash",
     "part": "cmnlib64",
     "slot": "both",
     "file": "stock:cmnlib64.img",
     "if": "firmware"
    },
    {
     "do": "flash",
     "part": "cmnlib",
     "slot": "both",
     "file": "stock:cmnlib.img",
     "if": "firmware"
    },
    {
     "do": "flash",
     "part": "abl",
     "slot": "both",
     "file": "stock:abl.elf",
     "if": "firmware"
    },
    {
     "do": "flash",
     "part": "mdtp",
     "slot": "both",
     "file": "stock:mdtp.img",
     "if": "firmware"
    },
    {
     "do": "flash",
     "part": "mdtpsecapp",
     "slot": "both",
     "file": "stock:mdtpsecapp.img",
     "if": "firmware"
    },
    {
     "do": "flash",
     "part": "system",
     "slot": "T",
     "file": "super_system"
    },
    {
     "do": "flash",
     "part": "vendor",
     "slot": "T",
     "file": "super_vendor"
    },
    {
     "do": "flash",
     "part": "boot",
     "slot": "T",
     "file": "boot"
    },
    {
     "do": "flash",
     "part": "vbmeta",
     "slot": "T",
     "file": "vbmeta"
    },
    {
     "do": "erase",
     "part": "userdata",
     "if": "wipe",
     "note": "erase, not format: a blank userdata gets a fresh metadata-encryption key on first boot"
    },
    {
     "do": "erase",
     "part": "logdump",
     "if": "wipe",
     "note": "logdump holds /metadata on this phone"
    },
    {
     "do": "zero",
     "part": "misc",
     "bytes": 2048,
     "note": "clear any pending recovery command"
    },
    {
     "do": "setActive",
     "slot": "T"
    },
    {
     "do": "reboot"
    },
    {
     "do": "done",
     "text": "Done. The first boot takes a few minutes."
    }
   ],
   "enabled": false,
   "disabledText": "Being tested on a real Mi A2. This flow opens once it has passed end to end; until then use the command-line steps on the release page."
  },
  "stock": {
   "title": "Back to stock",
   "summary": "Restore Xiaomi's Android 10 (V11.0.28) exactly like flash_all.sh. Erases everything.",
   "before": [
    "This replaces LineageOS with stock Android 10 and erases all data.",
    "Needs an unlocked and critical-unlocked bootloader.",
    "Boot to FASTBOOT (Volume Down + Power) and connect it."
   ],
   "files": [
    "stock:bluetooth.img",
    "stock:devcfg.img",
    "stock:dsp.img",
    "stock:modem.img",
    "stock:xbl.img",
    "stock:pmic.img",
    "stock:rpm.img",
    "stock:tz.img",
    "stock:hyp.img",
    "stock:keymaster.img",
    "stock:cmnlib64.img",
    "stock:cmnlib.img",
    "stock:abl.elf",
    "stock:boot.img",
    "stock:system.img",
    "stock:vendor.img",
    "stock:userdata.img",
    "stock:mdtp.img",
    "stock:splash.img",
    "stock:mdtpsecapp.img",
    "stock:storsec.mbn"
   ],
   "steps": [
    {
     "do": "check",
     "var": "product",
     "in": [
      "jasmine"
     ],
     "fail": "This is not a Mi A2."
    },
    {
     "do": "check",
     "var": "unlocked",
     "in": [
      "yes"
     ],
     "fail": "The bootloader is locked. Unlock it first."
    },
    {
     "do": "flash",
     "part": "bluetooth",
     "slot": "both",
     "file": "stock:bluetooth.img"
    },
    {
     "do": "flash",
     "part": "devcfg",
     "slot": "both",
     "file": "stock:devcfg.img"
    },
    {
     "do": "flash",
     "part": "dsp",
     "slot": "both",
     "file": "stock:dsp.img"
    },
    {
     "do": "flash",
     "part": "modem",
     "slot": "both",
     "file": "stock:modem.img"
    },
    {
     "do": "flash",
     "part": "xbl",
     "slot": "both",
     "file": "stock:xbl.img"
    },
    {
     "do": "flash",
     "part": "pmic",
     "slot": "both",
     "file": "stock:pmic.img"
    },
    {
     "do": "flash",
     "part": "rpm",
     "slot": "both",
     "file": "stock:rpm.img"
    },
    {
     "do": "flash",
     "part": "tz",
     "slot": "both",
     "file": "stock:tz.img"
    },
    {
     "do": "flash",
     "part": "hyp",
     "slot": "both",
     "file": "stock:hyp.img"
    },
    {
     "do": "flash",
     "part": "keymaster",
     "slot": "both",
     "file": "stock:keymaster.img"
    },
    {
     "do": "flash",
     "part": "cmnlib64",
     "slot": "both",
     "file": "stock:cmnlib64.img"
    },
    {
     "do": "flash",
     "part": "cmnlib",
     "slot": "both",
     "file": "stock:cmnlib.img"
    },
    {
     "do": "flash",
     "part": "abl",
     "slot": "both",
     "file": "stock:abl.elf"
    },
    {
     "do": "flash",
     "part": "boot",
     "slot": "both",
     "file": "stock:boot.img"
    },
    {
     "do": "flash",
     "part": "system",
     "slot": "both",
     "file": "stock:system.img"
    },
    {
     "do": "flash",
     "part": "vendor",
     "slot": "both",
     "file": "stock:vendor.img"
    },
    {
     "do": "flash",
     "part": "userdata",
     "slot": "none",
     "file": "stock:userdata.img"
    },
    {
     "do": "flash",
     "part": "mdtp",
     "slot": "both",
     "file": "stock:mdtp.img"
    },
    {
     "do": "flash",
     "part": "splash",
     "slot": "none",
     "file": "stock:splash.img"
    },
    {
     "do": "flash",
     "part": "mdtpsecapp",
     "slot": "both",
     "file": "stock:mdtpsecapp.img"
    },
    {
     "do": "flash",
     "part": "storsec",
     "slot": "none",
     "file": "stock:storsec.mbn"
    },
    {
     "do": "erase",
     "part": "ddr"
    },
    {
     "do": "setActive",
     "slot": "a"
    },
    {
     "do": "reboot"
    },
    {
     "do": "done",
     "text": "Stock Android 10 is installed. Let it boot and finish setup before you think about locking."
    }
   ],
   "enabled": false,
   "disabledText": "Being tested on a real Mi A2. This flow opens once it has passed end to end; until then use the command-line steps on the release page."
  },
  "lock": {
   "title": "Lock the bootloader",
   "summary": "Only on unmodified stock firmware. Erases everything.",
   "enabled": false,
   "disabledText": "Locking is not offered yet: it has not been tested end to end on a Mi A2 with these steps. Locking a phone that does not run untouched stock firmware can make it unbootable.",
   "before": [
    "Only after Back to stock has finished and stock Android has booted through setup.",
    "Keep OEM unlocking turned on in Developer options until the locked phone has booted once."
   ],
   "files": [],
   "steps": [
    {
     "do": "check",
     "var": "product",
     "in": [
      "jasmine"
     ],
     "fail": "This is not a Mi A2."
    },
    {
     "do": "confirm",
     "text": "I flashed stock V11.0.28 with this tool and it booted to the setup screen."
    },
    {
     "do": "command",
     "cmd": "flashing lock",
     "phone": "On the phone: select LOCK with the volume keys, then press Power. The phone erases itself."
    },
    {
     "do": "done",
     "text": "Locked. If it does not boot, unlock again from FASTBOOT and flash stock once more."
    }
   ]
  }
 }
}